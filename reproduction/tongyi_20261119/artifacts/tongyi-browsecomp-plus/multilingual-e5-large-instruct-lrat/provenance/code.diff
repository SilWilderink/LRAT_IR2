+    def _compute_in_batch_neg_loss(self, q_reps, p_reps, teacher_targets=None,
+                                   compute_score_func=None, reweight_rates=None, **kwargs):
+        # The abstract implementation accepts weights through **kwargs but does
+        # not pass them to compute_loss. Preserve LRAT weights for encoder runs.
+        if reweight_rates is None or teacher_targets is not None:
+            return super()._compute_in_batch_neg_loss(
+                q_reps, p_reps, teacher_targets=teacher_targets,
+                compute_score_func=compute_score_func, **kwargs)
+        score_func = self.compute_score if compute_score_func is None else compute_score_func
+        scores = score_func(q_reps, p_reps, **kwargs)
+        group_size = p_reps.size(0) // q_reps.size(0)
+        targets = torch.arange(q_reps.size(0), device=q_reps.device) * group_size
+        return scores, self.compute_loss(scores, targets, reweight_rates=reweight_rates)
+
